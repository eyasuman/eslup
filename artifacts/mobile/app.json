{
  "expo": {
    "name": "PULSE",
    "slug": "pulse-app-v-10",
    "owner": "the_god_of_monarch",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "1ccc71cb-a8be-4a2e-86f5-97b66dd11a02"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#202937"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pulse",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PULSE uses your location to find nearby healthcare providers.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pulsehealth.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#202937"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "PULSE needs camera access for video consultations with your doctor.",
          "microphonePermission": "PULSE needs microphone access for video consultations.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PULSE uses your location to find nearby healthcare providers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
